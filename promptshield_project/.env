# PromptShield Environment Configuration
# Copy this file to .env and fill in your values

# LLM Provider (mock, openai, or anthropic)
# mock runs fully offline and is best for quick coursework demos.
LLM_PROVIDER=openai

# OpenAI Configuration (using OpenRouter)
OPENAI_API_KEY=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
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct

# Anthropic Configuration (alternative)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Detection Pipeline Configuration
USE_EMBEDDING=true
USE_JUDGE=false
EMBEDDING_THRESHOLD=0.75
JUDGE_CONFIDENCE_THRESHOLD=0.7

# Judge LLM (can use different provider/model)
# JUDGE_LLM_PROVIDER=openai
# JUDGE_OPENAI_MODEL=gpt-4o-mini
# JUDGE_ANTHROPIC_MODEL=claude-3-haiku-20240307

# Django Configuration
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver